from collections import OrderedDict
from typing import Any, Callable, Dict, Generic, Iterator, ItemsView, KeysView, Mapping, Optional, Tuple, TypeVar, ValuesView

K = TypeVar('K')
V = TypeVar('V')

ReleaseHandlerType = Callable[[K, V], None]

# Don't inherit from Dict since we're overriding methods with incompatible signatures
class LRUCache(Generic[K, V]):
    capacity: int
    cache: OrderedDict[K, V]
    release_handler: Optional[Callable[[K, V], None]]
    
    def __init__(self, capacity: int, release_handler: Optional[Callable[[K, V], None]] = None) -> None: ...
    def __getitem__(self, key: K) -> Optional[V]: ...
    def __setitem__(self, key: K, value: V) -> None: ...
    def __delitem__(self, key: K) -> None: ...
    def __len__(self) -> int: ...
    def __contains__(self, key: object) -> bool: ...
    def items(self) -> Iterator[Tuple[K, V]]: ...
    def keys(self) -> Iterator[K]: ...
    def values(self) -> Iterator[V]: ...
    def clear(self) -> None: ...
    def __del__(self) -> None: ...